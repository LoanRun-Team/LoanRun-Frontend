# mock: full demo / hybrid: completed Home-Loans-Settings APIs only / real: all APIs
VITE_API_MODE=hybrid
# Leave empty to use the same-origin Vite /api proxy (recommended for session cookies).
VITE_API_BASE_URL=
# Replace with the deployed backend origin when available; restart npm run dev.
VITE_BACKEND_PROXY_TARGET=https://dev-api.loanrun.shop
# hybrid 모드에서 실서버로 보낼 영역(쉼표로 구분). 비워 두면 모두 Mock.
# 사용 가능: budget, finance, loans, products, onboarding, plans, risk, report
# 백엔드 컨트롤러가 올라오고 개발 서버가 새 이미지로 바뀐 영역만 적는다. 바꾼 뒤 dev 서버를 다시 시작한다.
# 배포(Vercel)에서는 VITE_API_BASE_URL=https://dev-api.loanrun.shop 도 함께 넣는다.
VITE_LIVE_FEATURES=
